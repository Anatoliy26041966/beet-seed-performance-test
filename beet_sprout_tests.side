{
  "id": "a1b2c3d4-e5f6-7890-abcd-1234567890ab",
  "version": "2.0",
  "name": "BeetSprout_Project",
  "url": "https://wikipedia.org",
  "tests": [
    {
      "id": "test-case-1",
      "name": "TC1_Wikipedia_Search_Verification",
      "commands": [
        { "id": "c1-1", "command": "open", "target": "/", "targets": [], "value": "" },
        { "id": "c1-2", "command": "setWindowSize", "target": "1280x800", "targets": [], "value": "" },
        { "id": "c1-3", "command": "store", "target": "Selenium", "targets": [], "value": "searchQuery" },
        { "id": "c1-4", "command": "verifyElementPresent", "target": "css=#searchInput", "targets": [], "value": "" },
        { "id": "c1-5", "command": "click", "target": "css=#searchInput", "targets": [], "value": "" },
        { "id": "c1-6", "command": "type", "target": "css=#searchInput", "targets": [], "value": "${searchQuery}" },
        { "id": "c1-7", "command": "verifyElementPresent", "target": "xpath=//button[@type='submit']", "targets": [], "value": "" },
        { "id": "c1-8", "command": "store", "target": "Search", "targets": [], "value": "btnLabel" },
        { "id": "c1-9", "command": "verifyElementPresent", "target": "css=.central-textlogo", "targets": [], "value": "" },
        { "id": "c1-10", "command": "verifyText", "target": "css=.jsl10n", "targets": [], "value": "Вільна енциклопедія" }
      ]
    },
    {
      "id": "test-case-2",
      "name": "TC2_Wikipedia_Navigation_Check",
      "commands": [
        { "id": "c2-1", "command": "open", "target": "/", "targets": [], "value": "" },
        { "id": "c2-2", "command": "setWindowSize", "target": "1280x800", "targets": [], "value": "" },
        { "id": "c2-3", "command": "store", "target": "English", "targets": [], "value": "langName" },
        { "id": "c2-4", "command": "verifyElementPresent", "target": "css=.central-featured", "targets": [], "value": "" },
        { "id": "c2-5", "command": "verifyElementPresent", "target": "xpath=//div[contains(@class,'central-featured-lang')]", "targets": [], "value": "" },
        { "id": "c2-6", "command": "click", "target": "css=#js-link-box-en", "targets": [], "value": "" },
        { "id": "c2-7", "command": "open", "target": "/", "targets": [], "value": "" },
        { "id": "c2-8", "command": "verifyElementPresent", "target": "css=#searchInput", "targets": [], "value": "" },
        { "id": "c2-9", "command": "store", "target": "1000000+", "targets": [], "value": "articleCount" },
        { "id": "c2-10", "command": "verifyElementPresent", "target": "xpath=//button[contains(@class,'pure-button')]", "targets": [], "value": "" }
      ]
    },
    {
      "id": "test-case-3",
      "name": "TC3_Wikipedia_Language_And_Footer_Check",
      "commands": [
        { "id": "c3-1", "command": "open", "target": "/", "targets": [], "value": "" },
        { "id": "c3-2", "command": "setWindowSize", "target": "1280x800", "targets": [], "value": "" },
        { "id": "c3-3", "command": "store", "target": "Donate", "targets": [], "value": "donateText" },
        { "id": "c3-4", "command": "verifyElementPresent", "target": "css=.footer", "targets": [], "value": "" },
        { "id": "c3-5", "command": "verifyElementPresent", "target": "xpath=//footer[contains(@class,'footer')]", "targets": [], "value": "" },
        { "id": "c3-6", "command": "verifyElementPresent", "target": "css=.search-container", "targets": [], "value": "" },
        { "id": "c3-7", "command": "verifyElementPresent", "target": "css=#searchLanguage", "targets": [], "value": "" },
        { "id": "c3-8", "command": "store", "target": "uk", "targets": [], "value": "langCode" },
        { "id": "c3-9", "command": "verifyElementPresent", "target": "css=#js-lang-list-button", "targets": [], "value": "" },
        { "id": "c3-10", "command": "verifyElementPresent", "target": "xpath=//div[contains(@class,'footer-sidebar')]", "targets": [], "value": "" }
      ]
    }
  ],
  "suites": [
    {
      "id": "suite-1",
      "name": "Default Suite",
      "persistSession": false,
      "parallel": false,
      "timeout": 300,
